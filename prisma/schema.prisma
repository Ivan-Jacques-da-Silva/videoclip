
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  username String @unique
  password String
  videos   Video[]

  @@map("users")
}

model Video {
  id           String   @id @default(cuid())
  filename     String
  originalName String   @map("original_name")
  duration     Int?     // in seconds
  filePath     String   @map("file_path")
  fileSize     Int      @map("file_size")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")
  userId       String?  @map("user_id")
  
  user           User?            @relation(fields: [userId], references: [id])
  cuts           Cut[]
  processingJobs ProcessingJob[]

  @@map("videos")
}

model Cut {
  id          String    @id @default(cuid())
  videoId     String    @map("video_id")
  title       String
  description String?
  hashtags    String?
  startTime   Int       @map("start_time") // in seconds
  endTime     Int       @map("end_time")   // in seconds
  duration    Int       // in seconds
  filePath    String?   @map("file_path")
  status      String    @default("pending") // pending, processing, ready, posted, error
  platforms   Json      @default("{}")     // {instagram: true, youtube: false, etc}
  obfuscation Json      @default("{}")     // obfuscation settings
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")
  
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("cuts")
}

model ProcessingJob {
  id          String    @id @default(cuid())
  videoId     String    @map("video_id")
  cutPoints   String    @map("cut_points") // "00:30|02:15|04:45|07:20"
  status      String    @default("queued") // queued, processing, completed, failed
  progress    Int       @default(0)
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("processing_jobs")
}
